{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["images", "sidecar", "controlPlane", "services"],
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "images": {
      "type": "object",
      "required": ["sidecar", "controlPlane", "order", "inventory", "recommendation", "etcd", "pullPolicy"]
    },
    "security": {
      "type": "object",
      "required": ["enabled", "revision", "trustDomain", "mtlsPort", "secretPrefix", "allowedPeers"],
      "properties": {
        "enabled": {"type": "boolean"},
        "revision": {"type": "string"},
        "trustDomain": {"type": "string", "minLength": 1},
        "mtlsPort": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "secretPrefix": {"type": "string", "minLength": 1},
        "allowedPeers": {"type": "object"}
      }
    },
    "transparentProxy": {
      "type": "object",
      "required": ["enabled", "listenPort", "proxyUID", "outboundPorts"],
      "properties": {
        "enabled": {"type": "boolean"},
        "listenPort": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "proxyUID": {"type": "integer", "minimum": 1},
        "outboundPorts": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 1, "maximum": 65535}
        }
      }
    },
    "sidecar": {
      "type": "object",
      "required": ["grpcPort", "metricsPort", "registrationTTL"],
      "properties": {
        "grpcPort": {"type": "integer", "minimum": 1, "maximum": 65535},
        "metricsPort": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    }
  }
}
