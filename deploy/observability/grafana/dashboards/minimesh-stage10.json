  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum by (service, code) (rate(minimesh_request_total[$__rate_interval]))", "legendFormat": "{{service}} {{code}}", "refId": "A"}],
      "title": "Request rate and errors",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, service) (rate(minimesh_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "{{service}}", "refId": "A"}],
      "title": "Request latency P95",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "id": 3,
      "targets": [{"expr": "sum by (service) (increase(minimesh_retry_total[$__range]))", "legendFormat": "{{service}}", "refId": "A"}],
      "title": "Retries",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "id": 4,
      "targets": [{"expr": "sum by (service) (increase(minimesh_circuit_breaker_total[$__range]))", "legendFormat": "{{service}}", "refId": "A"}],
      "title": "Circuit breaker rejections",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "id": 5,
      "targets": [{"expr": "sum by (service) (increase(minimesh_rate_limit_rejected_total[$__range]))", "legendFormat": "{{service}}", "refId": "A"}],
